# Copy to .env and replace every placeholder with strong values.
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_USER1_PASSWORD=replace-with-a-strong-user-password
SEED_USER2_PASSWORD=replace-with-a-strong-user-password
MONGODB_URI=mongodb://mongo:27017/nodegoat
